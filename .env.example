# ── TYDAL connection (server-only — never NEXT_PUBLIC) ──────────────────────
# Local Docker: only FULLFRAME_ENCRYPTION_KEY and ADMIN_PASSWORD need values;
# every other default below already fits.
#
# Optional server-side alias for a local TYDAL (no /api/v1). A pasted vault URL
# on TYDAL_LINK_BASE_URL (or localhost on the same port) is fetched via this
# instead; other origins connect directly. The default suits Docker; running on
# the host (npm run dev), use http://localhost:8000.
TYDAL_BASE_URL=http://host.docker.internal:8000

# Public TYDAL origin in shared URLs; mapped to TYDAL_BASE_URL for Docker.
# URLs on other origins connect directly. Defaults to TYDAL_BASE_URL.
TYDAL_LINK_BASE_URL=http://localhost:8000

# Master key that encrypts each exhibition's vault credentials at rest
# (AES-256-GCM). 32 bytes as base64 or hex — generate with:
#   openssl rand -base64 32
# Required once any exhibition stores a vault key. Rotating it strands existing
# stored keys (re-enter them via the admin binding form).
FULLFRAME_ENCRYPTION_KEY=

# ── Dev seed convenience (optional) ──────────────────────────────────────────
# The TYDAL FullFrameSeeder prints these three for the `first-frame` vault; set
# them here and `npm run db:seed` stores the keys on the seeded exhibition.
# Vault credentials are otherwise entered per-exhibition in the admin UI — there
# is no global VAULT_KEY / service token any more.
DEV_VAULT_HASH=
DEV_READ_VAULT_KEY=
DEV_WRITE_VAULT_KEY=

# ── Studio (/admin) ──────────────────────────────────────────────────────────
# Curators sign in with their TYDAL account (via TYDAL_BASE_URL above) and see
# their organizations' exhibitions. ADMIN_PASSWORD is the installation admin,
# who sees everything; unset = no installation admin (then set SESSION_SECRET).
ADMIN_PASSWORD=

# Optional explicit secret for the admin session cookie HMAC
# (defaults to a derivation of ADMIN_PASSWORD).
SESSION_SECRET=

# ── App ──────────────────────────────────────────────────────────────────────
# Public origin of this app — juror links, sitemap and robots.txt. Unset ⇒
# empty sitemap and relative juror links. Does not set the listening port.
APP_URL=http://localhost:3020

# Host port docker compose publishes the app on (the container listens on 3020).
FULLFRAME_PORT=3020

# Phase-gate bypass for dev/curator preview: pre-opening exhibitions render
# fully (pages AND the vault proxy) instead of the public teaser.
# NEVER enable in production. Ignored by docker compose (always false there).
PREVIEW_MODE=false

# ── Exhibition database ──────────────────────────────────────────────────────
# Used by npm run dev / db:* scripts. Ignored by docker compose, which pins it
# to the volume (/app/data/fullframe.sqlite).
DATABASE_PATH=./data/fullframe.sqlite
